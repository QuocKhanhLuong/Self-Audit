{
  "schema": "self_audit.candidate_a3d.v1",
  "method": "candidate_a3d",
  "stage": "teacher_warmup",
  "epochs": 10,
  "seed": 42,
  "threads": 2,
  "student_lr": 0.0003,
  "teacher_lr": 3e-05,
  "weight_decay": 0.0001,
  "teacher_update_every": 1,
  "freeze_teacher": false,
  "use_teacher": true,
  "lambda_distance": 1.0,
  "model": {
    "backbone": "mednext_l_k3",
    "source_repo": "",
    "source_commit": "",
    "weights": null,
    "weights_sha256": null
  },
  "teacher_init": {"kind": "none", "path": "", "sha256": ""},
  "class_mapping": ["BG", "RV", "MYO", "LV"],
  "dataset": {"name": "acdc", "protocol": "native_3d"},
  "validation_every": 1,
  "checkpoint_every_epochs": 1,
  "augmentation": "none",
  "bank": {
    "classes": [1, 2, 3],
    "region_grid": [2, 2, 2],
    "boundary_grid": [2, 2, 2],
    "region_scales": [0.5],
    "radius_mm": 5.0,
    "types": ["REGION", "BOUNDARY"]
  },
  "codec": {"value_bits": 8},
  "student": {
    "in_channels": 1,
    "num_classes": 4,
    "width": 16,
    "decoder_dim": 32,
    "num_heads": 4,
    "chunk_size": 4096,
    "local_queries": true,
    "depth": 2
  },
  "rollout": {
    "max_steps": 8,
    "candidate_limit": 9,
    "teacher_topk": 2,
    "student_topk": 2,
    "random_candidates": 2,
    "temperature": 0.1,
    "cost_lambda": 0.0001,
    "bit_budget": 4096,
    "baseline_ids": [0, 8, 16],
    "seed": 42,
    "policy_mode": "learned",
    "sample_policy": true,
    "policy_enabled": true,
    "teacher_proposal_types": ["REGION", "BOUNDARY"]
  },
  "loss": {"region": 1.0, "boundary": 1.0, "policy": 1.0}
}
