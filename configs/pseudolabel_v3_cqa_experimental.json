{
  "schema_version": 3,
  "teacher": {
    "width": 24,
    "appearance_dim": 48,
    "motion_dim": 16,
    "fused_dim": 64,
    "anonymous_prototypes": 12,
    "registration_max_displacement": 0.15
  },
  "reliability": {
    "min_probability": 0.7,
    "min_margin": 0.2,
    "prototype_min_confidence": 0.8
  },
  "loss_weights": {
    "reconstruction": 1.0,
    "anonymous_prototype": 0.01,
    "semantic_seed": 1.0,
    "motion_photometric": 1.0,
    "motion_smoothness": 0.05
  },
  "consistency": {
    "enabled": true,
    "temporal_weight": 0.5,
    "slice_weight": 0.0,
    "min_agreement": 0.6
  },
  "training": {
    "lr": 0.001,
    "weight_decay": 0.0001,
    "bounded_default_epochs": 3
  },
  "deployment": {
    "student_width": 32,
    "window_k": 8,
    "profiles": {
      "compact": 0,
      "balanced": 1,
      "accurate": 2
    },
    "entropy_compact": 0.25,
    "entropy_accurate": 0.55
  },
  "bootstrap": {
    "enabled": true,
    "readiness": {
      "min_successful_updates": 5,
      "min_train_samples": 4,
      "min_train_patients": 2,
      "min_observations_per_sample": 2,
      "min_mask_iou": 0.8,
      "min_region_pixels": 8,
      "min_contrast": 1.0,
      "min_edge_enrichment": 1.25,
      "min_temporal_neighbors": 1,
      "max_history_samples": 128,
      "max_mask_pixels": 262144,
      "min_assignment_probability": 0.7
    },
    "losses": {
      "spatial_weight": 0.3,
      "region_reconstruction_weight": 1.0,
      "edge_scale": 0.25,
      "counterfactual_audit": {
        "enabled": true,
        "distill_weight": 0.1,
        "max_edges": 512,
        "max_merges": 32,
        "max_atoms_per_group": 8,
        "min_fold_pixels": 2,
        "min_interface_pixels": 2,
        "min_real_neighbors": 1,
        "merge_risk_max": 0.01,
        "keep_risk_min": 0.04,
        "merge_boundary_max": 0.1,
        "keep_boundary_min": 0.35,
        "require_both_targets": true
      }
    },
    "regions": {
      "mode": "components",
      "min_region_pixels": 4,
      "max_components": 256,
      "min_probability": 0.7
    }
  }
}
