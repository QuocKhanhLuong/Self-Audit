+def paired_tensors():
+    q = torch.tensor([.15, .55, .15, .15]).view(1, 4, 1, 1).repeat(1, 1, 2, 2)
+    z = torch.tensor([.05, .85, .05, .05]).view(1, 4, 1, 1).repeat(1, 1, 2, 2)
+    weights = torch.tensor([[[.1, .2], [.3, 0.]]])
+    valid = torch.tensor([[[True, True], [True, False]]])
+    z[:, :, 1, 1] = float("nan")
+    return q, z, weights, valid
+
