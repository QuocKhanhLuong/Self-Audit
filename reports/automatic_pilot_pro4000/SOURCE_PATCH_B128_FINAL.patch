+def microbatch_pseudo_step(model, optimizers, strong, py, accepted, *, input_valid=None,
+                          microbatch_size=None):
+    """Pilot-only full EMA accumulation with one global denominator/clip/step.
+
+    Eval-mode NativeStudent has no batch-coupled normalization. Chunking changes
+    floating reduction order, not the effective-batch mathematical objective.
+    The canonical historical engine remains byte-for-byte unchanged.
+    """
+    if microbatch_size is not None and (type(microbatch_size) is not int or microbatch_size < 1):
+        raise ValueError("microbatch_size must be a positive integer")
+    if microbatch_size is None or len(strong) <= microbatch_size:
+        return full_pseudo_step(model, optimizers, strong, py, accepted, input_valid=input_valid)
+    model.eval()
+    model.zero_grad(set_to_none=True)
+    denominator = accepted.sum().clamp_min(1)
+    total_loss = 0.0
+    for start in range(0, len(strong), microbatch_size):
+        stop = min(start + microbatch_size, len(strong))
+        v = input_valid[start:stop] if input_valid is not None else None
+        logits = model(strong[start:stop], valid_mask=v)
+        loss = (F.cross_entropy(logits, py[start:stop], reduction="none")
+                * accepted[start:stop]).sum() / denominator
+        if not torch.isfinite(loss):
+            raise FloatingPointError("nonfinite microbatch pseudo loss")
+        loss.backward()
+        total_loss += float(loss.detach())
+    norm = torch.nn.utils.clip_grad_norm_(
+        [p for p in model.parameters() if p.requires_grad], 5., error_if_nonfinite=True)
+    for opt in optimizers:
+        opt.step()
+    return total_loss, float(norm)
+
+
