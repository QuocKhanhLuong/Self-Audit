new file mode 100644
index 0000000..db065a0
--- /dev/null
+++ b/tests/test_pseudo_microbatch.py
@@ -0,0 +1,39 @@
+import copy
+import pytest
+import torch
+from torch import nn
+from self_audit.automatic import microbatch_pseudo_step as full_pseudo_step
+
+class BatchIndependentModel(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.body=nn.Sequential(nn.Conv2d(3,8,3,padding=1),nn.GroupNorm(2,8),nn.GELU())
+        self.head=nn.Conv2d(8,4,1)
+    def forward(self,x,valid_mask=None):
+        return 25 * self.head(self.body(x))
+
+def test_microbatch_global_denominator_single_clip_and_optimizer_step():
+    torch.manual_seed(1907)
+    a=BatchIndependentModel().double();b=copy.deepcopy(a)
+    x=torch.randn(5,3,9,11,dtype=torch.float64);py=torch.randint(4,(5,9,11))
+    accepted=torch.rand(5,9,11)>.65;accepted[:2]=False;accepted[4]=True
+    opts_a=[torch.optim.SGD(a.head.parameters(),lr=.03),torch.optim.AdamW(a.body.parameters(),lr=.002)]
+    opts_b=[torch.optim.SGD(b.head.parameters(),lr=.03),torch.optim.AdamW(b.body.parameters(),lr=.002)]
+    la,na=full_pseudo_step(a,opts_a,x,py,accepted)
+    lb,nb=full_pseudo_step(b,opts_b,x,py,accepted,microbatch_size=2)
+    assert lb==pytest.approx(la,abs=1e-12)
+    assert nb==pytest.approx(na,abs=1e-12)
+    assert na > 5.0  # Exercise clipping once on the full accumulated gradient.
+    for p,q in zip(a.parameters(),b.parameters()):
+        assert torch.allclose(p,q,atol=1e-12,rtol=1e-12)
+        assert torch.allclose(p.grad,q.grad,atol=1e-12,rtol=1e-12)
+    for p,q in zip(a.body.parameters(),b.body.parameters()):
+        sa,sb=opts_a[1].state[p],opts_b[1].state[q]
+        assert sa['step'].item()==sb['step'].item()==1
+        for k in ['exp_avg','exp_avg_sq']:assert torch.allclose(sa[k],sb[k],atol=1e-12,rtol=1e-12)
+
+@pytest.mark.parametrize('value',[0,-1,True,1.5])
+def test_microbatch_rejects_invalid_size(value):
+    model=BatchIndependentModel()
+    with pytest.raises(ValueError,match='microbatch_size'):
+        full_pseudo_step(model,[torch.optim.SGD(model.parameters(),lr=.1)],torch.rand(3,3,5,5),torch.zeros(3,5,5,dtype=torch.long),torch.ones(3,5,5,dtype=torch.bool),microbatch_size=value)
